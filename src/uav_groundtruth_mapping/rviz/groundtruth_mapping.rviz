Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/PointCloud2
      Name: Gazebo Ground-Truth 3D Map
      Enabled: true
      Topic:
        Value: /groundtruth_pointcloud/map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Ground-Truth Scan
      Enabled: true
      Topic:
        Value: /groundtruth_pointcloud/registered_scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 1
    - Class: rviz_default_plugins/Path
      Name: Exact Gazebo Path
      Enabled: true
      Topic:
        Value: /groundtruth_pointcloud/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 255; 255
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 70
      Focal Point:
        X: 10
        Y: 8
        Z: 0
Window Geometry:
  Width: 1400
  Height: 900
